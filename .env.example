# ===== 地震预警后端 环境变量样板 =====
# 用法：本地运行时把本文件复制成 .env 再填值；部署到 Render 时在
# “Environment / 环境变量”页面逐项添加（不要把真实值提交到 GitHub）。

# 服务端口。本地默认 3000；Render 会自动注入 PORT，无需手动设置。
PORT=3000

# 腾讯位置服务 Key（只放服务器，App 里以后不再携带，防止被盗刷）
TENCENT_MAP_KEY=在这里填你的腾讯地图Key

# 极光「消息推送 JPush」凭证，在极光控制台「设置 & 密钥」里复制
JPUSH_APPKEY=在这里填你的极光AppKey
JPUSH_MASTER_SECRET=在这里填你的极光MasterSecret
# 国内账号保持默认；海外账号改成 https://api.jpush.io
JPUSH_API_BASE=https://api.jiguang.cn

# 数据源开关：1=开启 0=关闭
ENABLE_WOLFX=1
ENABLE_CENC_POLL=1
# 台网速报轮询间隔（毫秒），默认 8 秒
CENC_POLL_MS=8000
# Wolfx 实时 WebSocket（多个用英文逗号分隔）
WOLFX_URLS=wss://ws-api.wolfx.jp/fj_eew
# 中国地震台网速报镜像
CENC_LIST_URL=https://api.wolfx.jp/cenc_eqlist.json

# 最近事件缓存条数 / 去重时间窗（毫秒，默认 120 秒）
MAX_RECENT_ALERTS=30
DEDUP_MS=120000

# 数据文件目录（留空则用项目下 data/）
DATA_DIR=

# 可选：给所有 /api 接口加访问口令（请求头 x-auth-token）。留空=不校验，保持留空即可。
AUTH_TOKEN=
